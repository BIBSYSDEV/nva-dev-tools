#!/usr/bin/env bash
#MISE description="Show the current AWS identity and account."
#USAGE flag "-p --profile <profile>" help="AWS profile (default: AWS_PROFILE)"
set -euo pipefail

profile=${usage_profile:-}

# Exported rather than passed as --profile: an empty argument array trips set -u on the stock macOS bash 3.2
if [[ -n "$profile" ]]; then
  export AWS_PROFILE=$profile
fi

echo "Identity: $(aws sts get-caller-identity --query Arn --output text)"
echo "Account:  $(aws account get-account-information --query '[AccountId, AccountName]' --output text)"

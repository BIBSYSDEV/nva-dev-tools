#!/usr/bin/env bash
#MISE description="Show pipeline branches in all environments, or one."
#MISE dir="{{cwd}}"
#USAGE arg "[env]" help="One environment (default: all)" {
#USAGE   choices "e2e" "sandbox" "dev" "test" "prod"
#USAGE }
set -euo pipefail

# shellcheck source=mise/tasks/lib/nva-cli.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/nva-cli.sh"

if [[ -n "${usage_env:-}" ]]; then
  environments=("$usage_env")
else
  environments=(e2e sandbox dev test prod)
fi

for environment in "${environments[@]}"; do
  profile="nva-$environment"
  if [[ "$environment" == prod ]]; then
    profile="nva-prod-read"
  fi
  nva_cli --profile "$profile" pipelines branches
done

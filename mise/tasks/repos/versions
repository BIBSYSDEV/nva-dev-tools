#!/usr/bin/env bash
#MISE description="Show the last commit and the Java, Gradle, nva-commons and nva-gradle-plugins versions of every clone."
#MISE dir="{{cwd}}"
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
exec uv run --quiet --project "$repo_root" nva-dev repos versions "$@"

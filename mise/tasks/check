#!/usr/bin/env bash
#MISE description="Static checks for the current repo (Gradle, npm, uv, cfn-lint)."
#MISE dir="{{cwd}}"
#USAGE flag "--dry-run" help="Print the commands instead of running them"
set -euo pipefail

# shellcheck source=mise/tasks/lib/check-build.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/check-build.sh"

if [[ -x gradlew ]]; then
  # --continue so a violation in one module does not stop the checks in the others
  run ./gradlew --continue check -x test
fi

if [[ -f package.json ]]; then
  has_npm_script lint && run npm run lint
fi

if [[ -f pyproject.toml ]]; then
  pyproject_lists ruff && run uv run ruff check
  pyproject_lists ty && run uv run ty check
fi

if [[ -f template.yaml ]]; then
  run cfn-lint template.yaml
fi

if [[ "$matched" == false ]]; then
  echo "Nothing to check here: no gradlew, package.json, pyproject.toml or template.yaml in $PWD" >&2
  exit 1
fi

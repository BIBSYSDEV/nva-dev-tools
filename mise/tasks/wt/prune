#!/usr/bin/env bash
#MISE description="Show the worktrees as wt:list does, then remove the stale ones with their branches once confirmed."
#MISE alias="wtp"
#MISE dir="{{cwd}}"
#MISE raw=true
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
exec uv run --quiet --project "$repo_root" nva-dev wt prune "$@"

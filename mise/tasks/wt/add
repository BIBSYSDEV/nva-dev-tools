#!/usr/bin/env bash
#MISE description="Create a branch and a worktree for it."
#MISE alias="wta"
#MISE dir="{{cwd}}"
#USAGE arg "[branch]" help="Branch name (default: today's date)"
#USAGE arg "[base]" help="Start point (default: origin/HEAD)"
set -euo pipefail

branch=${usage_branch:-$(date +%F)}
base=${usage_base:-}

git fetch --quiet origin || echo "warning: fetch failed, using local state" >&2

if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  echo "Branch '$branch' already exists on origin; use wt:checkout to work on it" >&2
  exit 1
fi

repository_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
default_branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || echo origin/main)
worktree_path="$repository_root/${branch//\//-}"

git worktree add -b "$branch" "$worktree_path" "${base:-$default_branch}"
echo "$worktree_path"
